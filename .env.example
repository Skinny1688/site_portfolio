# SiteScan — copy to .env.local / .env (never commit secrets)

DATABASE_URL=postgres://sitescan:sitescan_dev@localhost:5433/sitescan
POSTGRES_PASSWORD=sitescan_dev

ADMIN_USER=admin
# Prefer bcrypt hash in production. Escape $ as \$ in env files.
# Example: ADMIN_PASSWORD_HASH=\$2b\$10\$...
ADMIN_PASSWORD_HASH=
# Local/dev fallback if hash is empty (do not use in production)
ADMIN_PASSWORD=

# min 32 chars in production
SESSION_SECRET=dev-session-secret-change-me-32chars

# Optional later: Telegram bot notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_NOTIFY_CHAT_ID=
